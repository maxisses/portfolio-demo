# Erzeugt von AAP (Katalog-Item "Namespace"). Nicht von Hand ändern.
# Bestellt von {{ requester }} über {{ channel }}, AAP-Job {{ request_id }}, {{ now_utc }}
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ns_name }}
  labels:
    portfolio-demo/managed-by: aap
    portfolio-demo/team: {{ team }}
    portfolio-demo/ordered-by: {{ channel }}
    portfolio-demo/request-id: "{{ request_id }}"
  annotations:
    openshift.io/requester: {{ requester }}
    openshift.io/display-name: "{{ ns_name }} (Team {{ team }})"
---
apiVersion: v1
kind: ResourceQuota
metadata:
  name: team-quota
  namespace: {{ ns_name }}
spec:
  hard:
    requests.cpu: "4"
    requests.memory: 8Gi
    limits.cpu: "8"
    limits.memory: 16Gi
    pods: "30"
    persistentvolumeclaims: "5"
---
apiVersion: v1
kind: LimitRange
metadata:
  name: defaults
  namespace: {{ ns_name }}
spec:
  limits:
    - type: Container
      default: { cpu: 500m, memory: 512Mi }
      defaultRequest: { cpu: 100m, memory: 128Mi }
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: team-admin
  namespace: {{ ns_name }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: admin
subjects:
  - apiGroup: rbac.authorization.k8s.io
    kind: Group
    name: team-{{ team }}
