# Generated by AAP (catalog item "Deploy App (Localnews)"). Do not edit by hand.
# Ordered by {{ requester }} via {{ channel }}, AAP job {{ request_id }}, {{ now_utc }}
{% if ai_enabled | bool %}
# Access to Models-as-a-Service for the app; value in AWS Secrets Manager.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: maas-access
  namespace: {{ namespace }}
  labels:
    portfolio-demo/managed-by: aap
    portfolio-demo/request-id: "{{ request_id }}"
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: aws-secrets-manager
  target:
    name: maas-access
  dataFrom:
    - extract:
        key: {{ maas_secret }}
---
{% endif %}
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: localnews-{{ namespace }}
  namespace: openshift-gitops
  labels:
    portfolio-demo/managed-by: aap
    portfolio-demo/ordered-by: {{ channel }}
    portfolio-demo/request-id: "{{ request_id }}"
spec:
  project: default
  source:
    repoURL: https://github.com/maxisses/portfolio-demo.git
    targetRevision: main
    path: apps/localnews/chart
    helm:
      releaseName: localnews
      valueFiles: [values.yaml]
      valuesObject:
        clusterDomain: {{ cluster_domain }}
        locationExtractor:
          image: image-registry.openshift-image-registry.svc:5000/localnews-build/location-extractor
          imageTag: llm
        llm:
          enabled: {{ ai_enabled | bool | lower }}
          secretName: maas-access
        externalDatabase:
          enabled: {{ (db_name | length > 0) | lower }}
          secretName: "{{ ('db-' ~ db_name) if db_name else '' }}"
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    retry:
      limit: 10
      backoff:
        duration: 15s
        factor: 1
