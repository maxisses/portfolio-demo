# Location extractor with optional LLM location extraction through Models-as-a-Service.
# Based on the dependency image of the ice-demo project (spaCy and language model).
FROM quay.io/mdargatz/icedemo:base

WORKDIR /opt/app-root/src

COPY --chown=1001:0 src/ /opt/app-root/src/src/

USER 1001
EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--timeout", "120", "src.wsgi:app"]
